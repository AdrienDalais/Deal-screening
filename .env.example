# Copy this file to .env and fill in real values.
# .env is git-ignored. Never put real keys in this file.

# --- LLM providers -------------------------------------------------
# Which provider to use by default: mistral_api | local_ollama
LLM_PROVIDER=mistral_api

# Hosted Mistral API. Used ONLY for deals whose confidentiality is
# 'synthetic' or 'public'. The code refuses to send 'confidential'
# deals to any hosted provider.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Local open-weight model via Ollama. The only provider permitted
# for deals marked 'confidential'.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Storage -------------------------------------------------------
DATABASE_URL=sqlite:///data/deals.db

# Where raw LLM request/response payloads are written for audit.
LLM_RUN_LOG_DIR=llm_runs

# Where uploaded deal documents are stored on disk.
DOCUMENT_STORE_DIR=deals_private

# --- Obsidian export -----------------------------------------------
# The database is the system of record. The vault is a read-only
# reading surface: exports go one way, database -> vault, never back.

# Absolute path to your vault. Leave blank to disable export entirely.
OBSIDIAN_VAULT_PATH=

# Folder inside the vault for generated deal notes. Everything written
# here is overwritten on each export and must not be hand-edited.
OBSIDIAN_DEALS_FOLDER=Deals

# Asserts the vault is on local disk only. Must be 'local_only' before
# a 'confidential' deal can be exported. Setting this to local_only is
# a claim, not proof — the code independently checks the path for cloud
# sync at runtime and refuses regardless of what is set here.
OBSIDIAN_VAULT_SYNC=local_only
